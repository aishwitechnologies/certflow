# Database Connection URL
# For local development with SQLite: file:./dev.db
# For production with Supabase / PostgreSQL: postgresql://postgres:[PASSWORD]@[HOST]:[PORT]/postgres?pgbouncer=true
DATABASE_URL="file:./dev.db"

# Public Application URL (used for verification links and base URLs)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# JWT Secret for Session Management
JWT_SECRET="certflow-super-secure-production-ready-jwt-secret-replace-in-prod-2026"

# Supabase Storage / PostgreSQL (Optional, if using direct Supabase)
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
STORAGE_BUCKET="certificates"

# Google OAuth & Google Sheets API Integration
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"
